<% reset_url = frontend_url('auth/password/edit', reset_password_token: @token) %>
<div style="font-family: Arial, Helvetica, sans-serif; color: #1f2937; max-width: 520px; margin: 0 auto; padding: 24px;">
  <p style="font-size: 18px; font-weight: bold; color: #1d4ed8; margin: 0 0 24px;">AlvoChat</p>

  <p style="font-size: 16px; margin: 0 0 12px;">Olá, <%= @resource.name.presence || @resource.email %>!</p>

  <p style="font-size: 14px; line-height: 22px; margin: 0 0 24px;">
    Recebemos um pedido para redefinir a senha da sua conta no AlvoChat
    (<strong><%= @resource.email %></strong>). Clique no botão abaixo para criar uma nova senha.
  </p>

  <p style="margin: 0 0 24px;">
    <a href="<%= reset_url %>"
       style="display: inline-block; background: #2563eb; color: #ffffff; text-decoration: none; font-size: 14px; font-weight: bold; padding: 12px 24px; border-radius: 8px;">
      Criar nova senha
    </a>
  </p>

  <p style="font-size: 12px; line-height: 18px; color: #6b7280; margin: 0 0 8px;">
    Se o botão não funcionar, copie e cole este endereço no navegador:<br>
    <a href="<%= reset_url %>" style="color: #2563eb; word-break: break-all;"><%= reset_url %></a>
  </p>

  <p style="font-size: 12px; line-height: 18px; color: #6b7280; margin: 16px 0 0;">
    O link vale por <%= (Devise.reset_password_within / 1.hour).round %> horas. Se você não pediu a troca de senha,
    ignore este e-mail: sua senha atual continua valendo.
  </p>
</div>
