# Copy this file to .env on the Docker server before running the production compose file.
# Replace every value marked CHANGE_ME with a real value. Do not commit the resulting .env file.

SECRET_KEY_BASE=CHANGE_ME_GENERATE_A_128_CHARACTER_HEX_VALUE
INSTALLATION_NAME=CRM Omnichannel
FRONTEND_URL=http://192.168.1.164:8069
FORCE_SSL=false
ENABLE_ACCOUNT_SIGNUP=false
RAILS_ENV=production
RAILS_MAX_THREADS=5

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_DATABASE_PASSWORD
# PostgreSQL's container uses these names. Keep them equal to the application values above.
POSTGRES_DB=chatwoot
POSTGRES_USER=chatwoot

REDIS_URL=redis://redis:6379
REDIS_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_REDIS_PASSWORD

MAILER_SENDER_EMAIL=CRM Omnichannel <atendimento@suaempresa.com>
SMTP_DOMAIN=suaempresa.com
SMTP_ADDRESS=CHANGE_ME_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true

ACTIVE_STORAGE_SERVICE=local

BAILEYS_BRIDGE_URL=http://baileys:3001
BAILEYS_API_TOKEN=CHANGE_ME_GENERATE_A_STRONG_BAILEYS_TOKEN
BAILEYS_CHATWOOT_CALLBACK_URL=http://rails:3000/api/v1/baileys
